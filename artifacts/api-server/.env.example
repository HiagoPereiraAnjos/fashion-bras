# API server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Required for Drizzle ORM and runtime DB access
# Local example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# Supabase pooler example (production):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
DB_SSL_MODE=disable
DB_POOL_MAX=10
DB_APPLICATION_NAME=fashion-bras-api-local

# Required for CORS allowlist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:4173
# Optional strict Vercel preview allowlist (recommended over regex):
# CORS_ALLOWED_VERCEL_PROJECTS=fashion-mall
# CORS_ALLOWED_VERCEL_TEAM_SLUG=hiagos-projects-e34ef41a
# Deprecated (ignored by current backend): CORS_ALLOWED_ORIGIN_REGEX
# Staging + production example:
# CORS_ALLOWED_ORIGINS=https://staging.fashionbras.com.br,https://fashionbras.com.br,https://www.fashionbras.com.br
# Production example:
# CORS_ALLOWED_ORIGINS=https://www.fashionbras.com.br,https://fashionbras.com.br

# Supabase (server-side secret values)
SUPABASE_URL=https://your-project-ref.supabase.co
# Never expose this key to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=site-media

# Optional emergency behavior: allows API reads to fallback to baseline JSON when a section is missing.
# Keep false in preview/production to guarantee Postgres as the single source of truth.
CONTENT_BASELINE_FALLBACK=false
