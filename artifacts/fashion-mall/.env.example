# Frontend (Vite)
# Required by vite.config.ts
PORT=4173
BASE_PATH=/

# Data mode
# local = localStorage/mock
# remote = API + Supabase Auth
VITE_CONTENT_BACKEND_MODE=local

# API base URL (used when VITE_CONTENT_BACKEND_MODE=remote)
VITE_API_BASE_URL=http://localhost:3000

# Public URL used for canonical/og metadata
VITE_SITE_URL=http://localhost:4173

# Supabase public credentials for admin login on frontend (remote mode)
# These are public client-side values (never use service-role key here).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backward compatibility aliases (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
