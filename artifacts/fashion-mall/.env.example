# Frontend (Vite)
# Optional in local dev (defaults: PORT=4173, BASE_PATH=/)
PORT=4173
BASE_PATH=/

# ---------------------------------------------------------------------------
# LOCAL (frontend + backend locais)
# ---------------------------------------------------------------------------
# local = localStorage/mock, sem API
# remote = API + Supabase Auth no admin
VITE_CONTENT_BACKEND_MODE=remote
VITE_API_BASE_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:4173

# ---------------------------------------------------------------------------
# PREVIEW (Vercel)
# ---------------------------------------------------------------------------
# VITE_CONTENT_BACKEND_MODE=remote
# VITE_API_BASE_URL=https://fashion-bras-api.vercel.app
# VITE_SITE_URL=https://<seu-frontend-preview-ou-dominio>.vercel.app

# ---------------------------------------------------------------------------
# STAGING (Vercel - QA externo)
# ---------------------------------------------------------------------------
# VITE_CONTENT_BACKEND_MODE=remote
# VITE_API_BASE_URL=https://fashion-bras-api.vercel.app
# VITE_SITE_URL=https://staging.fashionbras.com.br

# ---------------------------------------------------------------------------
# PRODUCTION (Vercel)
# ---------------------------------------------------------------------------
# VITE_CONTENT_BACKEND_MODE=remote
# VITE_API_BASE_URL=https://fashion-bras-api.vercel.app
# VITE_SITE_URL=https://<seu-dominio-producao>

# Supabase public credentials for admin login on frontend (remote mode)
# These values are public/client-side. Never place service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backward compatibility aliases (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
