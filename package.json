{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');const ua=process.env.npm_config_user_agent||'';['package-lock.json','yarn.lock'].forEach((f)=>{try{fs.rmSync(f,{force:true});}catch{}});if(!ua.startsWith('pnpm/')){console.error('Use pnpm instead');process.exit(1);}\"",
    "dev": "pnpm run dev:frontend",
    "dev:frontend": "pnpm --filter @workspace/fashion-mall dev",
    "dev:api": "pnpm --filter @workspace/api-server dev",
    "build:frontend": "pnpm --filter @workspace/fashion-mall build",
    "build:api": "pnpm --filter @workspace/api-server build",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:generate": "pnpm --filter @workspace/db generate",
    "db:migrate": "pnpm --filter @workspace/db migrate",
    "db:push": "pnpm --filter @workspace/db push",
    "seed:content-baseline": "pnpm --filter @workspace/scripts seed:content-baseline"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp": "^8.4.0"
    }
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
